{
  "name": "primordials",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "Primordials — a living ecosystem on your desktop. Real Lotka-Volterra dynamics running in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
