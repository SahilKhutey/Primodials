# ─────────────────────────────────────────────
# Primordials — Environment Variables
# Copy to .env.local and fill in
# ─────────────────────────────────────────────

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://primordials.dev

# Plausible Analytics (privacy-friendly)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=primordials.dev
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# GitHub API (optional, for live star count)
NEXT_PUBLIC_GITHUB_REPO=SahilKhutey/Primodials
GITHUB_TOKEN= # optional, increases rate limit

# Discord & Contact
NEXT_PUBLIC_DISCORD_INVITE=primordials
NEXT_PUBLIC_CONTACT_EMAIL=hello@primordials.dev
