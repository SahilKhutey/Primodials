# Environment Variables — Polygonal Primordials

# Supabase (optional — the app runs fully offline without these)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
#
# Without these keys:
#   - The simulation runs normally in browser and Wallpaper Mode
#   - Cloud save / load / auto-checkpoint are disabled
#   - The History tab shows "Cloud saves unavailable"
#
# With these keys:
#   - Save simulation snapshots to the cloud
#   - Load previous experiments from any device
#   - Auto-checkpoint runs periodically in the background

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
