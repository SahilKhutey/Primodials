# ─────────────────────────────────────────────
# Primordials — .gitignore
# ─────────────────────────────────────────────

# ── Build outputs ────────────────────────────
build/
out/
dist/
dist-*/
dist-wallpaper/
dist-wallpaper-engine/
dist-itch/
dist-release-*/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.idb

# ── Generated by CMake ───────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps
Testing/
compile_commands.json

# ── Node.js ──────────────────────────────────
node_modules/
.npm/
.eslintcache
.parcel-cache/
.vite/
*.log

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── IDEs ─────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── OS ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/

# ── Project-specific ─────────────────────────
.cache/
.primordials/
logs/
coverage/

# ── Secrets ──────────────────────────────────
.env
.env.local
.env.*.local
*.pem
secrets.yaml
google-credentials.json
aws-credentials

# ── Saves (local dev) ────────────────────────
saves/*.json
!saves/.gitkeep
