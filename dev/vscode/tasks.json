{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "./build_all.sh all",
      "options": {
        "env": {
          "BUILD_TYPE": "Debug"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Build Release",
      "type": "shell",
      "command": "./build_all.sh all",
      "options": {
        "env": {
          "BUILD_TYPE": "Release"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "build/bin/ShapeEngineTests.exe",
      "group": "test"
    },
    {
      "label": "Generate Icons",
      "type": "shell",
      "command": "python tools/icon_generator.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build"
    }
  ]
}
