# ─────────────────────────────────────────────
# Primordials — EditorConfig
# ─────────────────────────────────────────────
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{cpp,hpp,h,cc,cxx,c,h++}]
indent_size = 4
max_line_length = 100

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,toml}]
indent_size = 2
max_line_length = 120

[CMakeLists.txt]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2
